{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Resto POS",
  "version": "0.1.2",
  "identifier": "com.fyc.resto.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Resto POS — نظام إدارة المطاعم",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "copyright": "© 2026 FYC Solutions. All rights reserved.",
    "shortDescription": "نظام Resto POS لإدارة المطاعم والمبيعات والمخزون — FYC Solutions",
    "longDescription": "نظام سطح مكتب متكامل لإدارة الطلبات والمبيعات والمخزون والمطابخ Resto POS من تطوير FYC Solutions",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4N0U0NEYyMEJDRjZEOApSV1RZOXJ3Z1QrU0hCVGpMYU95THREeDV3R3FsSUg1ZWhCbnp6bjl6SFhTUTNoSU9YbVg2aDNyQgo=",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
