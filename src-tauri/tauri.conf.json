{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "بيتنا POS",
  "version": "0.1.0",
  "identifier": "com.beitna.restaurant.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "بيتنا — إدارة المطعم",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "نظام نقطة بيع وإدارة مطعم بيتنا",
    "longDescription": "نظام سطح مكتب لإدارة طلبات وتحصيلات ومطبخ مطعم بيتنا",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
